@model IReadOnlyList<Healthcare.Core.Entities.Appointment>
@{
    ViewData["Title"] = "My Appointments";
    ViewData["PageTitle"] = "My Appointments";
    ViewData["Subtitle"] = "Only appointments linked to your patient profile are shown.";
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Appointment History</h5>
            <a asp-action="BookAppointment" class="btn btn-sm btn-success">Book New</a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">No appointments found.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Doctor</th>
                            <th>Reason</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.AppointmentDateTime.ToString("dd-MMM-yyyy hh:mm tt")</td>
                            <td>@item.Doctor?.FullName</td>
                            <td>@item.Reason</td>
                            <td><span class="badge bg-primary">@item.Status</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
