@model Healthcare.MVC.ViewModels.UserBookAppointmentViewModel
@{
    ViewData["Title"] = "Book Appointment";
    ViewData["PageTitle"] = "Book Appointment";
    ViewData["Subtitle"] = "Book an appointment using your linked patient profile.";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        @* PatientId is not present in this form. It is taken securely from the logged-in user's linked profile. *@
        <form asp-action="BookAppointment" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DoctorId" class="form-label"></label>
                    <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select">
                        <option value="">-- Select Doctor --</option>
                    </select>
                    <span asp-validation-for="DoctorId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AppointmentDateTime" class="form-label"></label>
                    <input asp-for="AppointmentDateTime" type="datetime-local" class="form-control" />
                    <span asp-validation-for="AppointmentDateTime" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DurationMinutes" class="form-label"></label>
                    <input asp-for="DurationMinutes" class="form-control" />
                    <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Reason" class="form-label"></label>
                    <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Reason for visit"></textarea>
                    <span asp-validation-for="Reason" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">Confirm Booking</button>
                <a asp-action="Dashboard" class="btn btn-outline-secondary">Back</a>
            </div>
        </form>
    </div>
</div>
