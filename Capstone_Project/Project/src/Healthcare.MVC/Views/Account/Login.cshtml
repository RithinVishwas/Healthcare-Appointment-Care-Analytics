@*
  File: src/Healthcare.MVC/Views/Account/Login.cshtml
  Layer: MVC presentation layer
  Purpose: This file is the Razor view responsible for rendering server-side UI while preserving MVC separation of concerns.
  Security note: MVC validation and antiforgery tokens help protect forms from invalid input and CSRF attacks.
  Change note: Only documentation comments were added; executable logic and project behavior remain unchanged.
*@

@* Detailed Razor comments below explain UI binding, validation, security, and navigation behavior without changing markup logic. *@
@* Strongly typed model lets Razor bind form fields/table output to a safe ViewModel or DTO. *@
@model LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Healthcare Analytics</title>
    @* Bootstrap CDN provides responsive UI components without building a separate SPA framework. *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    @* Bootstrap CDN provides responsive UI components without building a separate SPA framework. *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    @* Project CSS file contains custom styling for the healthcare dashboard UI. *@
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-body">
    <div class="login-card">
        <div class="login-hero">
            <i class="bi bi-heart-pulse"></i>
            <h1>Healthcare Appointment & Care Analytics</h1>
            <p>Secure staff login for patient scheduling and analytics.</p>
        </div>
        @* Form posts data back to the controller action for server-side validation and saving. *@
        @* Tag Helpers generate correct MVC URLs, reducing hardcoded links and routing mistakes. *@
        <form asp-action="Login" method="post" class="login-form">
            @* Anti-forgery token protects this form from CSRF attacks. *@
            @Html.AntiForgeryToken()
            @* Validation summary shows model-level errors returned from the controller. *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <label asp-for="Email" class="form-label"></label>
            @* asp-for binds this input to a ViewModel property and enables validation messages. *@
            <input asp-for="Email" class="form-control" placeholder="admin@healthcare.local" />
            @* Validation span displays server/client validation errors near the related field. *@
            <span asp-validation-for="Email" class="text-danger"></span>
            <label asp-for="Password" class="form-label mt-3"></label>
            @* asp-for binds this input to a ViewModel property and enables validation messages. *@
            <input asp-for="Password" class="form-control" placeholder="Admin@123" />
            @* Validation span displays server/client validation errors near the related field. *@
            <span asp-validation-for="Password" class="text-danger"></span>
            <button class="btn btn-primary w-100 mt-4" type="submit">Login securely</button>
            <div class="demo-box mt-3">Demo: admin@healthcare.local / Admin@123</div>
        </form>
                <div class="text-center mt-3">
                    <span>New user?</span>
                    <a asp-controller="Account" asp-action="Register">Register here</a>
                </div>
    </div>
</body>
</html>
